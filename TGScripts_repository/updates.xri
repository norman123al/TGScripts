<xri version="1.0">
   <description>
      <p>
        TGScripts - PixInsight scripts provided by Thorsten Glebe.
     </p>
   </description>
   <platform os="all" arch="noarch" version="1.9.6.1718:1.9.99">
      <package fileName="TGScripts_repository.tar.gz" sha1="986fad8a1ef2aaa7793208ca332971f1f9352188" type="script" releaseDate="20261116">
         <title>
            TGScripts - Astro Bucket List 0.46.0
         </title>
         <remove>
            src/scripts/TGScripts
            doc/scripts/AberrationInspectorTG
            doc/scripts/AberrationSpotterTG
            doc/scripts/AstroBucketList
            doc/scripts/BBStarReduction
            doc/scripts/ColorMaskTG
            doc/scripts/CSTG
            doc/scripts/DarkStructureEnhanceTG
            doc/scripts/DeconvolutionPreviewTG
            doc/scripts/LinearMasterBlend
            doc/scripts/LocalSupportMask
            doc/scripts/LRGBDeconvolutionMatch
            doc/scripts/ROILinearFit
            doc/scripts/StarSpikeProtectionMask
            doc/scripts/SubframeQualityReview
            doc/scripts/TGScriptSkeleton
            doc/scripts/EmissionLineIntegrationTG
            doc/scripts/TGFieldMosaic
            doc/scripts/TGCornerMosaic
            doc/scripts/TGHueRangeMask
            doc/scripts/TGDustContrast
            doc/scripts/TGPSFComparison
         </remove>
         <description>
            <p>
               Astro Bucket List 0.46.0 adds saved observing-site profiles with independent coordinates, UTC offsets, observing limits and custom horizons. Existing site settings are preserved.
            </p>
            <p>
               Edit horizon points or import Stellarium polygonal horizon files. Planning accounts for directional obstructions and displays the horizon along each target’s path.
            </p>
            <p>
               Export all results, usable targets or selected rows as CSV or printable PDF. Add planned targets to new or existing observing lists while retaining metadata and other memberships.
            </p>
            <p>
               Time labels now clearly identify local time. A midnight divider and calendar-date labels replace the “+1” suffix; PDF windows include explicit dates. Documentation and the README have been updated.
            </p>
            <p>
               Copyright (c) 2026 Dr. Thorsten Glebe. All Rights Reserved.
            </p>
         </description>
      </package>
   </platform>
</xri>
