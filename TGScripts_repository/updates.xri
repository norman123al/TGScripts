   <platform os="all" arch="noarch" version="1.8.9:1.9.99">
      <package fileName="TGScripts_repository.tar.gz" sha1="b5816a571d3b19cbd710a730e4ab0eefc88b498d" type="script" releaseDate="20261031">
         <title>
            TGScripts snapshot - 2026 Okt 31
         </title>
         <remove>
            src/scripts/TGScripts
            doc/scripts/AberrationInspectorTG
            doc/scripts/AberrationSpotterTG
            doc/scripts/AstroBucketList
            doc/scripts/BBStarReduction
            doc/scripts/ColorMaskTG
            doc/scripts/CSTG
            doc/scripts/DarkStructureEnhanceTG
            doc/scripts/DeconvolutionPreviewTG
            doc/scripts/LinearMasterBlend
            doc/scripts/LocalSupportMask
            doc/scripts/LRGBDeconvolutionMatch
            doc/scripts/ROILinearFit
            doc/scripts/StarSpikeProtectionMask
            doc/scripts/SubframeQualityReview
            doc/scripts/TGScriptSkeleton
         </remove>
         <description>
            <p>
                The repository provides a set of improved Pixinsight scripts from various authors as well as some newly written scripts.
            </p>
            <p>
               Updates:
               <br/>
               Astro Bucket List 0.12.0 adds batch checking of selected objects, two-level sorting, and a Reset filters action. Finder charts now show optional constellation borders and provide individual catalog controls with explicit NGC/IC magnitude limits. Preview access is simplified through the existing tabs. Documentation has been updated.
            </p>
            <p>
               Copyright (c) 2026 Dr. Thorsten Glebe. All Rights Reserved.
            </p>
         </description>
      </package>
